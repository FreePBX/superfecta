<?php

define("LDAP_OPENLDAP", "1");
define("LDAP_OPENDIRECTORY", "2");
define("LDAP_CUSTOM", "3");

class LDAP extends superfecta_base {

    public $description = "This source will search an LDAP Server and return the Common Name (<strong>cn</strong>) for a telephone number.<br><br>Attempts are made to match telephoneNumber, mobile and homeTelephoneNumber.<br><br><strong>Note: php-ldap is required to be installed for this to work</strong>.";
    public $version_requirement = "2.11";
    public $source_param = array(
        'LDAP_Host' => array(
            'description' => 'LDAP Server to search.<br>The port is optional e.g. ldap.example.com:389<br><br>To connect through SSL prefix the connection with <strong>ldaps</strong> e.g. ldaps://ldap.example.com<br><br>This value may be used to automatically create the <b>dc</b> component for the <b>LDAP User</b> below, depending on the value of <b>LDAP Server</b>, e.g. dc=ldap,dc=example,dc=com',
            'type' => 'text'
        ),
        'LDAP_User' => array(
            'description' => 'Authentication Username to connect to the LDAP server.  Other information is added to the field value, depending on the value of <b>LDAP Server</b>:<br><br><small>Open LDAP</small>: cn=<i><b>LDAP User</b></i>, dc=<i>automatically created from <b>LDAP Host</b></i><br><br><small>Apple Open Directory</small>: uid=<i><b>LDAP User</b></i>,cn=users, dc=<i>automatically created from <b>LDAP Host</b></i><br><br><small>Custom</small>: <i><b>LDAP User</b></i>',
            'type' => 'text'
        ),
        'LDAP_Password' => array(
            'description' => 'Password used to connect to the LDAP server',
            'type' => 'password'
        ),
        'LDAP_Server' => array(
            'description' => 'LDAP service provider to connect to',
            'type' => 'select',
            'option' => array(
                LDAP_OPENLDAP => 'Open LDAP',
                LDAP_OPENDIRECTORY => 'Apple Open Directory',
                LDAP_CUSTOM => 'Custom'
            ),
            'default' => LDAP_OPENLDAP
        ),
        'LDAP_Unit' => array(
            'description' => 'Organizational Unit to search.  Leave blank to search all OU.  Other information is added to the field value, depending on the value of <b>LDAP Server</b>:<br><br><small>Open LDAP</small>: ou=<i><b>LDAP Unit</b></i>, dc=<i>automatically created from <b>LDAP Host</b></i><br><br><small>Apple Open Directory</small>: ou=<i><b>LDAP Unit</b></i>, dc=<i>automatically created from <b>LDAP Host</b></i><br><br><small>Custom</small>: <i><b>LDAP Unit</b></i>',
            'type' => 'text'
        ),
        'LDAP_Format' => array(
            'description' => 'Specify the format required.<br><br>Valid values are<br><pre>
1 - Common Name (cn)
2 - LastName, FirstName
3 - FirstName LastName
4 - Organization - Lastname (cn if Organization blank)
5 - AppleCompany - Lastname (cn if Company blank)</pre>',
            'type' => 'select',
            'option' => array(
                1 => '(cn) e.g. Joe Bloggs',
                2 => '(sn, givenname) e.g. Bloggs, Joe',
                3 => '(givenname sn) e.g. Joe Bloggs',
                4 => '(o - sn) e.g. Acme - Bloggs',
                5 => '(applecompany - sn) e.g. Acme - Bloggs'
            ),
            'default' => 1
        ),
        'Filter_Length' => array(
            'description' => 'The number of rightmost digits to check for a match. Leave empty to check all digits.',
            'type' => 'number'
        )
    );

    // Wall-clock cap. LDAP_OPT_NETWORK_TIMEOUT does not abort a peer that
    // accepts the TCP connection and then stays silent.
    protected $lookup_deadline = 5;

    function get_caller_id($thenumber, $run_param=array()) {
        $caller_id = null;

        $this->DebugPrint("Searching LDAP for number: {$thenumber}");

        // By default, the found name is empty
        $name = "";

        // check if php-ldap is installed
        function_exists('ldap_connect') or $this->DebugDie("LDAP functions not available - please check if php-ldap is installed");

        // parse host and port info 
        $connection = @parse_url($run_param['LDAP_Host']) or $this->DebugDie("No LDAP host specified - Check config LDAP_Host");
        // print_r($connection); echo("<br>\n");
        // set default to ldap
        $scheme = 'ldap';

        // beware - different keys returned if port is present or not	
        if (array_key_exists('path', $connection) && (strlen($connection['path']) > 1)) {
            $server = $connection['path'];
        } elseif (array_key_exists('host', $connection) && (strlen($connection['host']) > 1)) {
            $server = $connection['host'];
        } else {
            $this->DebugDie("Unable to determine LDAP server name");
        }

        // build DC string from host name supplied
        // e.g. "ldap.example.com" becomes "dc=ldap,dc=example,dc=com"
        $dc = "dc=" . implode(",dc=", explode('.', $server));

        // Add port to server connect string if required
        if (array_key_exists('port', $connection)) {
            $server .= ':' . $connection['port'];
        }

        // Check for SSL connection string
        if (array_key_exists('scheme', $connection)) {
            if ($connection['scheme'] === 'ldaps') {
                $scheme = 'ldaps';
            }
        }

        // #50 - Allow for different output fields		
        $fields = array('1' => 'cn', // CommonName
            '2' => 'sn, givenname', // LastName, FirstName
            '3' => 'givenname sn', // FirstName LastName
            '4' => 'o - sn', // Organisation LastName
            '5' => 'apple-company - sn' // Company LastName
        );

        // Validate Formatting Options
        if (array_key_exists($run_param['LDAP_Format'], $fields)) {
            $fieldlist = preg_split("/[\s,]+/", $fields[$run_param['LDAP_Format']]);

            if (array_search("-", $fieldlist)) {
                unset($fieldlist[array_search("-", $fieldlist)]);
            }

            // Add 'cn' to field list if not present
            if (!array_search('cn', $fieldlist)) {
                $fieldlist[] = 'cn';
            }

            $fieldlist = array_unique($fieldlist);
        } else {
            $this->DebugDie("Invalid Format requested.");
        }

        // Set user id
        switch ($run_param['LDAP_Server']) {
            case LDAP_OPENDIRECTORY:
                $UID = "uid={$run_param['LDAP_User']},cn=users, {$dc}";
                break;

            case LDAP_OPENLDAP:
                $UID = "cn={$run_param['LDAP_User']}, {$dc}";
                break;

            case LDAP_CUSTOM:
                $UID = $run_param['LDAP_User'];
                break;
        }
        // if ($run_param['LDAP_Server'] == LDAP_OPENDIRECTORY) {
        //     $UID = "uid={$run_param['LDAP_User']},cn=users, {$dc}";
        // } else {
        //     $UID = "cn={$run_param['LDAP_User']}, {$dc}";
        // }

        // Check for OU to limit search
        if (strlen($run_param['LDAP_Unit']) > 0) {
            // Allow for embedded quotes to avoid LDAP injection
            $ou = addslashes($run_param['LDAP_Unit']);

            // Set Organizational Unit e.g "ou=people, dc=ldap,dc=example,dc=com"
            switch ($run_param['LDAP_Server']) {
                case LDAP_OPENDIRECTORY:
                case LDAP_OPENLDAP:
                    $dn = "ou={$ou},{$dc}";
                    break;

                case LDAP_CUSTOM:
                    $dn = $run_param['LDAP_Unit'];
                    break;
            }
        } else {
            $dn = "{$dc}";
        }

        $this->DebugEcho("Attempting to bind, using UID:'$UID' ... <br>");
        $this->DebugEcho("Searching {$dn} ... ");

        // Rightmost digits, then digits only, so the filter cannot carry LDAP syntax.
        if (isset($run_param['Filter_Length']) && !empty($run_param['Filter_Length'])) {
            $thenumber = substr($thenumber, (-1 * $run_param['Filter_Length']));
        }
        $thenumber = preg_replace('/\D+/', '', (string)$thenumber);

        // ldap_bind/ldap_search run in a child. A parent-side deadline can
        // stop a silent peer and still return to the dialplan.
        $info = null;
        if ($thenumber !== '') {
            $attrs = $this->isDebug(DEBUG_ALL) ? array('*') : array_values($fieldlist);
            $info = $this->ldapLookup("{$scheme}://{$server}", $UID, $run_param['LDAP_Password'], $dn, $thenumber, $attrs);
        }

        if (is_array($info)) {
            $this->DebugPrint($info["count"] . " entries returned");

                if ($info["count"] > 0) {
                    $this->DebugDump($info[0], DEBUG_ALL);

                    // Default to cn if any field is missing
                    $cn = $info[0]['cn'][0];
                    $name = "";

                    // Remove cn from list as not required.					
                    if (array_search('cn', $fieldlist)) {
                        unset($fieldlist[array_search('cn', $fieldlist)]);
                        $fieldlist = array_values($fieldlist);
                    }

                    // #50 - loop and add comma if required. 
                    foreach ($fieldlist as $field) {
                        if (array_key_exists($field, $info[0])) {
                            $name .= $info[0][$field][0];
                            $name .= (strpos(" " . $fields[$run_param['LDAP_Format']], "{$field},", 1) ? ", " : " " );
                            $name .= (strpos(" " . $fields[$run_param['LDAP_Format']], "{$field} -", 1) ? "- " : " " );
                        } else {
                            // Default to cn if any field is missing
                            $name = $cn;
                            break;
                        }
                    }
                }
        }

        // If we found a match, return it
        if (strlen(trim($name)) > 1) {
            $caller_id = trim($name);
        } else {
            $this->DebugPrint("not found");
        }

        return $caller_id;
    }


    /**
     * Query LDAP in a child PHP process and return ldap_get_entries(), or
     * null when the deadline passes or the query fails. Returning null
     * lets the next caller-ID source run. DebugDie would end the AGI.
     */
    private function ldapLookup($uri, $binddn, $bindpw, $base, $number, $attrs) {
        $seconds = (float)$this->lookup_deadline;
        if ($seconds < 0.2) {
            $seconds = 0.2;
        }
        $net = (int)ceil($seconds);
        if ($net < 1) {
            $net = 1;
        }
        $attrEnv = in_array('*', $attrs, true) ? '*' : implode(',', $attrs);
        $env = array(
            'PATH' => '/usr/bin:/bin',
            'LANG' => 'C.UTF-8',
            'SF_LDAP_URI' => (string)$uri,
            'SF_LDAP_BINDDN' => (string)$binddn,
            'SF_LDAP_BINDPW' => (string)$bindpw,
            'SF_LDAP_BASE' => (string)$base,
            'SF_LDAP_NUMBER' => (string)$number,
            'SF_LDAP_ATTRS' => (string)$attrEnv,
            'SF_LDAP_NET_TIMEOUT' => (string)$net,
        );
        $stdout = $this->runBoundedPhp($this->ldapLookupScript(), $env, $seconds);
        if ($stdout === null) {
            return null;
        }
        $decoded = json_decode($stdout, true);
        if (!is_array($decoded) || empty($decoded['ok']) || !isset($decoded['entries']) || !is_array($decoded['entries'])) {
            $err = (is_array($decoded) && isset($decoded['error'])) ? $decoded['error'] : 'LDAP lookup returned nothing';
            $this->DebugPrint($err);
            return null;
        }
        return $decoded['entries'];
    }

    private function cliPhpBinary() {
        $base = basename(PHP_BINARY);
        $cliSapi = (PHP_SAPI === 'cli' || PHP_SAPI === 'phpdbg');
        $looksLikePhp = (strpos($base, 'php') === 0);
        $notAServer = (strpos($base, 'fpm') === false && strpos($base, 'cgi') === false && strpos($base, 'apache') === false);
        if ($cliSapi && $looksLikePhp && $notAServer && @is_executable(PHP_BINARY)) {
            return PHP_BINARY;
        }
        $names = array('php', 'php8.3', 'php8.2', 'php8.1', 'php8.0', 'php7.4');
        $dirs = array();
        if (defined('PHP_BINDIR') && PHP_BINDIR !== '') {
            $dirs[] = PHP_BINDIR;
        }
        $dirs[] = '/usr/bin';
        $dirs[] = '/usr/local/bin';
        foreach ($dirs as $dir) {
            foreach ($names as $name) {
                $path = $dir . '/' . $name;
                if (@is_executable($path)) {
                    return $path;
                }
            }
        }
        return null;
    }

    /**
     * Run a PHP script, passed on stdin, and return its stdout.
     * Reads stdout and stderr together so a full pipe cannot deadlock.
     * Kills the child when $seconds elapses. Returns null on timeout
     * or if the child is still running when the pipes close.
     */
    private function runBoundedPhp($script, $env, $seconds) {
        $php = $this->cliPhpBinary();
        if ($php === null) {
            $this->DebugPrint('LDAP lookup could not find a PHP CLI binary');
            return null;
        }
        $pipes = array();
        $proc = @proc_open(array($php), array(
            0 => array('pipe', 'r'),
            1 => array('pipe', 'w'),
            2 => array('pipe', 'w'),
        ), $pipes, null, $env);
        if (!is_resource($proc)) {
            $this->DebugPrint('LDAP lookup could not be started');
            return null;
        }
        @fwrite($pipes[0], $script);
        @fclose($pipes[0]);
        @stream_set_blocking($pipes[1], false);
        @stream_set_blocking($pipes[2], false);

        $stdout = '';
        $tooLarge = false;
        $deadline = microtime(true) + (float)$seconds;
        $open = array(1 => $pipes[1], 2 => $pipes[2]);
        while ($open) {
            $left = $deadline - microtime(true);
            if ($left <= 0) {
                break;
            }
            $read = array_values($open);
            $write = null;
            $except = null;
            $sec = (int)floor($left);
            $usec = (int)(($left - $sec) * 1000000);
            if ($usec < 0) {
                $usec = 0;
            } elseif ($usec > 999999) {
                $usec = 999999;
            }
            $n = @stream_select($read, $write, $except, $sec, $usec);
            if ($n === false) {
                usleep(10000);
                continue;
            }
            if ($n > 0 && is_array($read)) {
                foreach ($read as $pipe) {
                    $idx = null;
                    foreach ($open as $i => $candidate) {
                        if ($candidate === $pipe) {
                            $idx = $i;
                            break;
                        }
                    }
                    $chunk = @fread($pipe, 8192);
                    if (!is_string($chunk) || $chunk === '') {
                        $meta = @stream_get_meta_data($pipe);
                        if ($idx !== null && is_array($meta) && !empty($meta['eof'])) {
                            unset($open[$idx]);
                        }
                        continue;
                    }
                    if ($idx === 1) {
                        $stdout .= $chunk;
                        if (strlen($stdout) > 262144) {
                            $tooLarge = true;
                            $stdout = '';
                            $open = array();
                            break;
                        }
                    }
                }
            }
        }
        if (!$tooLarge) {
            foreach (array(1, 2) as $idx) {
                if (!isset($pipes[$idx]) || !is_resource($pipes[$idx])) {
                    continue;
                }
                while (strlen($stdout) <= 262144) {
                    $chunk = @fread($pipes[$idx], 8192);
                    if (!is_string($chunk) || $chunk === '') {
                        break;
                    }
                    if ($idx === 1) {
                        $stdout .= $chunk;
                    }
                }
            }
        }
        $status = @proc_get_status($proc);
        $running = is_array($status) && !empty($status['running']);
        if (strlen($stdout) > 262144) {
            $tooLarge = true;
        }
        if ($running || $tooLarge) {
            @proc_terminate($proc, 9);
        }
        $decodedEarly = json_decode($stdout, true);
        $complete = is_array($decodedEarly) && !empty($decodedEarly['ok']);
        if ($tooLarge || ($running && !$complete)) {
            $stdout = '';
            $failed = true;
        } else {
            $failed = false;
        }
        foreach (array(1, 2) as $idx) {
            if (isset($pipes[$idx]) && is_resource($pipes[$idx])) {
                @fclose($pipes[$idx]);
            }
        }
        @proc_close($proc);
        if ($failed) {
            $why = $tooLarge ? 'LDAP lookup result was too large' : 'LDAP lookup exceeded ' . $seconds . 's and was abandoned';
            $this->DebugPrint($why);
            return null;
        }
        return $stdout;
    }

    private function ldapLookupScript() {
        return <<<'PHP'
<?php
ini_set('display_errors', '0');
$uri = getenv('SF_LDAP_URI');
$binddn = getenv('SF_LDAP_BINDDN');
$bindpw = getenv('SF_LDAP_BINDPW');
$base = getenv('SF_LDAP_BASE');
$number = preg_replace('/\D+/', '', (string)getenv('SF_LDAP_NUMBER'));
$attrEnv = getenv('SF_LDAP_ATTRS');
$net = (int)getenv('SF_LDAP_NET_TIMEOUT');
if ($binddn === false) {
    $binddn = '';
}
if ($bindpw === false) {
    $bindpw = '';
}
if ($net < 1) {
    $net = 1;
}
$fail = function ($msg) {
    echo json_encode(array('ok' => false, 'error' => $msg));
    exit(0);
};
if ($uri === false || $uri === '' || $base === false || $base === '' || $number === '' || !function_exists('ldap_connect')) {
    $fail('LDAP lookup is not available');
}
$ad = @ldap_connect($uri);
if (!$ad) {
    $fail('Could not connect to LDAP server');
}
@ldap_set_option($ad, LDAP_OPT_PROTOCOL_VERSION, 3);
@ldap_set_option($ad, LDAP_OPT_REFERRALS, 0);
if (defined('LDAP_OPT_NETWORK_TIMEOUT')) {
    @ldap_set_option($ad, LDAP_OPT_NETWORK_TIMEOUT, $net);
}
if (defined('LDAP_OPT_TIMEOUT')) {
    @ldap_set_option($ad, LDAP_OPT_TIMEOUT, $net);
}
if (!@ldap_bind($ad, $binddn, $bindpw)) {
    $fail('Could not bind to LDAP server');
}
if ($attrEnv === false || $attrEnv === '' || $attrEnv === '*') {
    $attrList = array('*');
} else {
    $attrList = explode(',', $attrEnv);
}
$filter = '(|(telephoneNumber=*' . $number . ')(mobile=*' . $number . ')(homeTelephoneNumber=*' . $number . '))';
$rs = @ldap_search($ad, $base, $filter, $attrList);
if (!$rs) {
    @ldap_unbind($ad);
    $fail('LDAP search failed');
}
$info = @ldap_get_entries($ad, $rs);
@ldap_unbind($ad);
if (!is_array($info)) {
    $fail('LDAP search failed');
}
$flags = 0;
if (defined('JSON_UNESCAPED_UNICODE')) {
    $flags |= JSON_UNESCAPED_UNICODE;
}
if (defined('JSON_INVALID_UTF8_SUBSTITUTE')) {
    $flags |= JSON_INVALID_UTF8_SUBSTITUTE;
}
$json = json_encode(array('ok' => true, 'entries' => $info), $flags);
if ($json === false) {
    $fail('LDAP result could not be encoded');
}
echo $json;
exit(0);

PHP;
    }

}
